@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 12
skinparam monochrome false

' SC2006 Clean Palette
skinparam ActorBorderColor #1e3a8a
skinparam ActorBackgroundColor #dbeafe
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam usecase {
  BackgroundColor #ffffff
  BorderColor #2563eb
  FontColor #0f172a
  FontSize 11
  ArrowColor #475569
  ArrowFontSize 10
}

left to right direction

' ==========================================
' ACTORS
' ==========================================
actor "Driver\n(Guest User)" as Driver
actor "Registered Driver" as RegDriver

actor "Authentication Service\n(Supabase Auth)" as AuthService <<system>>
actor "Carpark Data Service\n(data.gov.sg / LTA)" as CarparkService <<system>>
actor "Weather Service\n(data.gov.sg NEA)" as WeatherService <<system>>
actor "Routing & Places Service\n(Google Maps Platform)" as RoutingService <<system>>
actor "Browser Geolocation API" as GeoService <<system>>

' Actor Inheritance
RegDriver -up-|> Driver

' ==========================================
' SYSTEM BOUNDARY
' ==========================================
rectangle "Smart Parking Recommendation Application" {
  
  ' Authentication & Profile Subsystem
  usecase "UC-12: Register / Login" as UC12
  usecase "UC-13: Manage User Profile" as UC13
  
  ' Favourites Subsystem
  usecase "UC-10: Save Favourite Location" as UC10
  usecase "UC-11: Manage Saved Locations" as UC11
  
  ' Primary Search & Filtering
  usecase "UC-01: Search Destination and\nView Recommended Carparks" as UC01
  usecase "UC-07: Filter Carparks" as UC07
  
  ' Carpark Details & Selection
  usecase "UC-06: View Carpark Details" as UC06
  usecase "UC-08: Select Carpark" as UC08
  usecase "UC-14: Manage & Receive\nAvailability Alerts" as UC14
  
  ' Navigation & Routes Subsystem
  usecase "UC-09: View Route to Carpark\nand Destination" as UC09
  
  ' Subordinate & Algorithmic Use Cases
  usecase "UC-15: Generate Carpark\nRecommendations" as UC15
  usecase "UC-02: Get Real-Time\nCarpark Information" as UC02
  usecase "UC-03: Calculate Driving Time" as UC03
  usecase "UC-04: Calculate Walking\nDistance & Time" as UC04
  usecase "UC-05: Get Weather Forecast" as UC05
  usecase "UC-16: Get Historical\nCarpark Availability" as UC16
}

' ==========================================
' ACTOR ASSOCIATIONS
' ==========================================
Driver --> UC12
Driver --> UC01
Driver --> UC06
Driver --> UC08
Driver --> UC09

RegDriver --> UC13
RegDriver --> UC10
RegDriver --> UC11
RegDriver --> UC14

' External System Associations
UC12 --- AuthService
UC13 --- AuthService

UC01 --- GeoService
UC01 --- RoutingService

UC02 --- CarparkService
UC16 --- CarparkService

UC05 --- WeatherService

UC03 --- RoutingService
UC04 --- RoutingService
UC09 --- RoutingService

' ==========================================
' USE CASE DEPENDENCIES (<<include>> & <<extend>>)
' ==========================================
UC07 .> UC01 : <<extend>>
UC11 .> UC01 : <<invokes>>

UC01 .> UC15 : <<include>>

UC15 .> UC02 : <<include>>
UC15 .> UC03 : <<include>>
UC15 .> UC04 : <<include>>
UC15 .> UC05 : <<include>>
UC15 .> UC16 : <<include>>

UC06 .> UC02 : <<include>>
UC06 .> UC05 : <<include>>

UC10 .> UC06 : <<extend>>
UC14 .> UC06 : <<extend>>
UC14 .> UC02 : <<include>>

UC09 .> UC03 : <<include>>
UC09 .> UC04 : <<include>>
UC09 .> UC05 : <<include>>

@enduml
